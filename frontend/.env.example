# Nhost Cloud Configuration
# Get these from your Nhost Dashboard → Project Settings
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-project-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# Hasura GraphQL Endpoint
# Cloud: https://your-project.hasura.eu-central-1.nhost.run/v1/graphql
# Local: http://localhost:8080/v1/graphql
NEXT_PUBLIC_HASURA_ENDPOINT=https://your-project.hasura.eu-central-1.nhost.run/v1/graphql

# Hasura Admin Secret (from Nhost Dashboard → Hasura → Settings)
HASURA_ADMIN_SECRET=your-hasura-admin-secret

# Groq API Key (optional - uses stubbed mode if empty)
GROQ_API_KEY=

# Slack Webhook URL (optional - for notifications)
SLACK_WEBHOOK_URL=

# Nhost Functions URL (for Hasura Actions)
# Cloud: https://your-project.functions.eu-central-1.nhost.run
# Local: http://localhost:3001
NHOST_FUNCTIONS_URL=https://your-project.functions.eu-central-1.nhost.run
